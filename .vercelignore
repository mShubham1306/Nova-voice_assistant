# ─── Vercel Deployment Ignore Rules ──────────────────────────────────────────
# Only the frontend/ folder is built on Vercel. Everything else below saves
# upload time and build minutes.

# Backend (deployed separately on Render)
backend/
api/

# Python
__pycache__/
*.pyc
*.pyo
venv/
.venv/
env/
requirements*.txt
*.egg-info/

# Docker
Dockerfile
Dockerfile.*
docker-compose*.yml
.dockerignore
render.yaml

# CI / Git
.github/
.git/
.gitignore

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Node (root-level — frontend/ has its own node_modules)
node_modules/
*.log
npm-debug.log*

# Build artifacts
dist/
build/

# Env secrets
.env
.env.local
.env.*.local
backend/.env

# Tests
backend/tests/
*.test.js
*.spec.js
