# ═══════════════════════════════════════════════════════════════════════════════
#  NOVA BACKEND — ENVIRONMENT VARIABLES
#  LOCAL DEV:  Copy this file → rename to `.env` inside backend/ folder
#  PRODUCTION: Set all keys in Render Dashboard (render.yaml defines ALL of them)
#  SECTION ORDER MATCHES: render.yaml ←→ backend/.env.example ←→ root .env.example
# ═══════════════════════════════════════════════════════════════════════════════

# ─── 1. CRITICAL REQUIRED ────────────────────────────────────────────────────
# Get free API key: https://aistudio.google.com/   (MANDATORY — no default)
GEMINI_API_KEY=

# Render auto-generates via generateValue:true. For local dev use any random string.
SECRET_KEY=nova-super-secret-key-change-in-production

# LOCAL DEV: leave EMPTY → defaults to localhost:5173, localhost:3000, *.vercel.app, *
# PRODUCTION: comma-separated Vercel URLs. Set AFTER Vercel deploys:
#   CORS_ORIGINS=https://nova-frontend.vercel.app,https://custom-domain.com
CORS_ORIGINS=

# ─── 2. SERVER ───────────────────────────────────────────────────────────────
# development = verbose logs + localhost CORS
# production  = quiet logs + /tmp data dir + strict mode (use on Render)
ENVIRONMENT=development

# Bind all interfaces — 0.0.0.0 = accessible on network (Render requires this)
HOST=0.0.0.0

# Render auto-sets PORT=10000 via env var at runtime; local dev uses 5000
PORT=5000

# PRODUCTION MUST SET: DEBUG=False  (disables uvicorn reload, reduces verbosity)
DEBUG=True

# Forces unbuffered Python stdout so Render shows real-time logs
PYTHONUNBUFFERED=1

# Docker image PYTHONPATH — do NOT modify (needed for backend module imports)
PYTHONPATH=/app

# ─── 3. IDENTITY ─────────────────────────────────────────────────────────────
# Used in greeting messages, API status endpoint, wake-word detection
ASSISTANT_NAME=Nova
WAKE_WORD=hey nova

# ─── 4. AI / GEMINI ──────────────────────────────────────────────────────────
# Options:
#   gemini-2.0-flash   = Fast + cheap (DEFAULT — recommended)
#   gemini-1.5-flash   = Stable legacy
#   gemini-1.5-pro     = Smarter but slower + more expensive
GEMINI_MODEL=gemini-2.0-flash

# Max output tokens per response
# 256  = very short
# 512  = default balanced (matches Settings class backend/config.py:74)
# 1024 = long detailed answers
# 2048 = very long (may hit rate limits faster)
GEMINI_MAX_TOKENS=512

# ─── 5. VOICE ENGINE ─────────────────────────────────────────────────────────
# Browser does client-side TTS via Web Speech API. Server-side pyttsx3 fallback
# uses these. Render headless container has no audio hardware.
VOICE_RATE=180
# WPM: 150 slow, 180 natural, 210 fast

VOICE_GENDER=female
# Options: female | male — picks closest installed system voice

LISTEN_TIMEOUT=5
# Seconds to wait for speech start before giving up

PHRASE_TIME_LIMIT=8
# Max seconds allowed per single speech utterance

LANGUAGE=en-in
# BCP-47 language code: en-in = English India | en-us = English US | hi = Hindi | ...

# ─── 6. PATHS ────────────────────────────────────────────────────────────────
# Auto-overridden to /tmp/nova_data/* in production (backend/config.py:170-176)
# Change ONLY if you need custom persistent paths; Render uses ephemeral /tmp
DATA_DIR=./backend/data
NOTES_DIR=./backend/data/notes
SCREENSHOTS_DIR=./backend/data/screenshots
OUTPUT_DIR=./backend/data/output
MEMORY_FILE=./backend/data/memory.json

# ─── 7. USER ENVIRONMENT PATHS ───────────────────────────────────────────────
# Auto-detected from Path.home() at startup. Change for custom workspace layouts.
# Not meaningful in Render Docker container (OS user = root, no Desktop).
USER_HOME=~/
PROJECTS_DIR=~/Desktop
DOWNLOADS_DIR=~/Downloads
DOCUMENTS_DIR=~/Documents

# ─── 8. APP PATHS DICT (ADVANCED) ────────────────────────────────────────────
# JSON object mapping app-name → Windows executable path.
# Leave EMPTY to use hardcoded defaults (backend/config.py:89-118).
# No effect on Render/Linux — these are Windows-only exe paths.
# Example:
# APP_PATHS={"chrome":"C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe","vscode":"code"}
APP_PATHS=

# ─── 9. WEBSITE SHORTCUTS DICT (ADVANCED) ────────────────────────────────────
# JSON object mapping name → URL. Leave EMPTY for built-in list.
# Leave EMPTY to use hardcoded defaults (backend/config.py:122-139).
# Example:
# WEBSITE_SHORTCUTS={"google":"https://google.com","yt":"https://youtube.com"}
WEBSITE_SHORTCUTS=
