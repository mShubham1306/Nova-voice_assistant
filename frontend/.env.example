# ═══════════════════════════════════════════════════════════════════════════════
#  NOVA FRONTEND — ENVIRONMENT VARIABLES
#  Copy to `.env.local` for local dev. Set in Vercel Dashboard for production.
#  All env vars MUST be prefixed with VITE_ to be exposed to the browser bundle.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Backend API URL (CRITICAL for production) ────────────────────────────────
#
#  LOCAL DEVELOPMENT:
#    Leave EMPTY → Vite dev server proxies /api → http://localhost:5000
#
#  PRODUCTION (Vercel):
#    Set to your RENDER backend URL (NO trailing slash!):
#    VITE_API_URL=https://nova-backend.onrender.com
#
#  NOTE: After deploying backend first, copy the Render URL here, then
#        re-deploy the frontend on Vercel.
VITE_API_URL=

# ─── App Identity (Optional) ──────────────────────────────────────────────────
VITE_APP_NAME=Nova
VITE_ASSISTANT_NAME=Nova

# ─── Features (Optional toggles) ──────────────────────────────────────────────
VITE_ENABLE_VOICE=true
VITE_ENABLE_WAKE_WORD=true
VITE_WAKE_WORD=hey nova
