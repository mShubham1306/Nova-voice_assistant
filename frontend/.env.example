# NOVA Frontend — Environment Variables
#
# Copy this file to .env.local for local development.
# Set VITE_API_URL in Vercel dashboard for production.
#
# ─────────────────────────────────────────────────────────────────────────────
# VITE_API_URL:
#   Leave EMPTY for local development (Vite dev server proxies /api → localhost:5000)
#   Set to your Render backend URL for production:
#   VITE_API_URL=https://nova-voice-assistant-backend.onrender.com
# ─────────────────────────────────────────────────────────────────────────────
VITE_API_URL=
